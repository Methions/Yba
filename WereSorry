local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "MaintenanceNotice"
gui.ResetOnSpawn = false

local parent = player:WaitForChild("PlayerGui")
if gethui then
    local success, result = pcall(gethui)
    if success then parent = result end
end

gui.Parent = parent

local sound = Instance.new("Sound")
sound.SoundId = "rbxassetid://3069892996"
sound.Volume = 1
sound.Parent = gui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0.85, 0, 0, 165)
frame.Position = UDim2.fromScale(0.5, 0.5)
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
frame.BorderSizePixel = 0
frame.Parent = gui

local limit = Instance.new("UISizeConstraint")
limit.MaxSize = Vector2.new(360, 165)
limit.MinSize = Vector2.new(260, 165)
limit.Parent = frame

Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -30, 0, 35)
title.Position = UDim2.fromOffset(15, 15)
title.BackgroundTransparency = 1
title.Text = "We're sorry."
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 20
title.Font = Enum.Font.GothamSemibold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = frame

local message = Instance.new("TextLabel")
message.Size = UDim2.new(1, -30, 0, 45)
message.Position = UDim2.fromOffset(15, 52)
message.BackgroundTransparency = 1
message.Text = "This script is currently under maintenance. We apologize for the inconvenience. Thank you for your patience."
