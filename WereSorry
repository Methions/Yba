local plr = game:GetService("Players").LocalPlayer
local soundservice = game:GetService("SoundService")

local gui = Instance.new("ScreenGui")
gui.Name = "MaintenanceNotice"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true

local parent = plr:WaitForChild("PlayerGui")

if gethui then
    local ok, hui = pcall(gethui)
    if ok and hui then
        parent = hui
    end
end

gui.Parent = parent

local s = Instance.new("Sound")
s.SoundId = "rbxassetid://3069892996"
s.Volume = 1
s.Parent = soundservice

local f = Instance.new("Frame")
f.Parent = gui
f.Size = UDim2.new(.85, 0, 0, 165)
f.Position = UDim2.new(.5, 0, .5, 0)
f.AnchorPoint = Vector2.new(.5,.5)
f.BackgroundColor3 = Color3.fromRGB(20,20,20)
f.BorderSizePixel = 0

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0,8)
corner.Parent = f

local limit = Instance.new("UISizeConstraint")
limit.Parent = f
limit.MaxSize = Vector2.new(360,165)
limit.MinSize = Vector2.new(260,165)

local title = Instance.new("TextLabel",f)
title.BackgroundTransparency = 1
title.Position = UDim2.new(0,15,0,15)
title.Size = UDim2.new(1,-30,0,35)
title.Font = Enum.Font.GothamSemibold
title.Text = "We're sorry."
title.TextSize = 20
title.TextColor3 = Color3.fromRGB(255,255,255)
title.TextXAlignment = Enum.TextXAlignment.Left

local msg = Instance.new("TextLabel")
msg.Parent = f
msg.BackgroundTransparency = 1
msg.Position = UDim2.new(0,15,0,52)
msg.Size = UDim2.new(1,-30,0,45)
msg.Font = Enum.Font.Gotham
msg.Text = "This script is currently under maintenance. We apologize for the inconvenience. Thank you for your patience."
msg.TextSize = 13
msg.TextColor3 = Color3.fromRGB(175,175,175)
msg.TextWrapped = true
msg.TextXAlignment = Enum.TextXAlignment.Left

local close = Instance.new("TextButton")
close.Parent = f
close.Size = UDim2.new(1,-30,0,32)
close.Position = UDim2.new(0,15,1,-43)
close.BackgroundColor3 = Color3.fromRGB(240,240,240)
close.TextColor3 = Color3.fromRGB(20,20,20)
close.Text = "Close"
close.TextSize = 13
close.Font = Enum.Font.GothamSemibold
close.AutoButtonColor = true

local c = Instance.new("UICorner")
c.Parent = close
c.CornerRadius = UDim.new(0,6)

s:Play()

close.Activated:Connect(function()
    gui:Destroy()
    s:Destroy()
end)
