close.TextSize = 13
close.Font = Enum.Font.GothamSemibold
close.Parent = frame

Instance.new("UICorner", close).CornerRadius = UDim.new(0, 6)

sound:Play()

close.Activated:Connect(function()
    gui:Destroy()
